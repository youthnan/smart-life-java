# 服务
HOST=127.0.0.1
PORT=9000

# LLM（可选）
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=6

# hm-dianping（Spring）启动前 export 上述 LLM_* 即可被 application.yaml 读取；无需单独 DASHSCOPE_*（仍兼容 DASHSCOPE_API_KEY）

# Java 后端地址（用于商户/优惠券实时查询）
BACKEND_BASE_URL=http://127.0.0.1:8088
BACKEND_TIMEOUT_SECONDS=5

# 地图默认参数（用户未提供坐标时）
DEFAULT_MAP_X=120.149993
DEFAULT_MAP_Y=30.334229
DEFAULT_MAP_RADIUS=2000

